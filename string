using System;

class Program
{
    static void Main()
    {
        Console.Write("Write a string to compress");
        string str = Console.ReadLine();

        string result = "";

        int count = 1;

        for (int i = 0; i < str.Length; i++)
        {
            if (i + 1 < str.Length && str[i] == str[i + 1])
            {
                count++;
            }
            else
            {
                result = result + str[i] + count;
                count = 1;
            }
        }

        Console.WriteLine(result);
    }
}
